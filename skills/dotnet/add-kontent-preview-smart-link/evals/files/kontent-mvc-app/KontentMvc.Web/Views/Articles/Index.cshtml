@model PagedResult<ArticleViewModel>
@{
    ViewData["Title"] = "Articles";
}

<h1>Articles</h1>

@if (Model.Items.Count == 0)
{
    <p class="text-muted">No articles have been published yet.</p>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var article in Model.Items)
        {
            <div class="col">
                <article class="card h-100">
                    @* A null asset renders nothing, so no guard is needed here.
                       No width/height attributes: those would drop srcset/sizes. *@
                    <img-asset asset="@article.Image"
                               title="@article.ImageAltText"
                               default-width="480"
                               class="card-img-top" />
                    <div class="card-body">
                        <h2 class="card-title h5">
                            <a asp-route="ArticleDetail" asp-route-slug="@article.Slug">@article.Title</a>
                        </h2>
                        @if (article.PublishedOn is { } publishedOn)
                        {
                            <p class="card-subtitle text-muted small">
                                <time datetime="@publishedOn.ToString("yyyy-MM-dd")">@publishedOn.ToString("d MMMM yyyy")</time>
                            </p>
                        }
                        <p class="card-text">@article.Summary</p>
                    </div>
                </article>
            </div>
        }
    </div>

    <nav class="d-flex justify-content-between align-items-center mt-4" aria-label="Article listing pages">
        @if (Model.HasPrevious)
        {
            <a class="btn btn-outline-secondary" asp-route="ArticleListing" asp-route-page="@(Model.PageNumber - 1)">Previous</a>
        }
        else
        {
            <span></span>
        }

        <span class="text-muted small">
            Page @Model.PageNumber@(Model.TotalCount is { } total ? $" - {total} article(s)" : string.Empty)
        </span>

        @if (Model.HasNext)
        {
            <a class="btn btn-outline-secondary" asp-route="ArticleListing" asp-route-page="@(Model.PageNumber + 1)">Next</a>
        }
        else
        {
            <span></span>
        }
    </nav>
}
